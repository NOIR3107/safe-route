# "mock" runs the full system in-browser (seeded Chennai flood scenario, persisted to IndexedDB).
# "live" sends requests to the FastAPI backend in this repository.
VITE_API_MODE=mock
VITE_API_BASE_URL=http://localhost:8000/api/v1

# god's-eye-view (integrations/gods-eye-view), started with `npm run gev`
VITE_GEV_URL=http://localhost:4173
