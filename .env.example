# SafeRoute Environment Configuration

PROJECT_NAME="SafeRoute - Disaster Evacuation & Shelter Allocation System"
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1

# Security
SECRET_KEY=supersecret-key-change-in-production-safemode-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default uses local SQLite for seamless plug-and-play development:
DATABASE_URL=sqlite:///./saferoute.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saferoute_db

# CORS Configuration (comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
