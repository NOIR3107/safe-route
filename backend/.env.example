# Copy to backend/.env and adjust. Every value here has a working default for local development.

# PostgreSQL (the live database is the source of truth; drills run on a copy in the second one)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/saferoute
DRILL_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/saferoute_drill

# JWT - change the secret outside the lab
SECRET_KEY=change-this-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Login page demo buttons (lab only)
DEMO_ACCOUNTS=true

# Live feed ingestion: feeds send this in the X-Ingest-Token header
INGEST_TOKEN=dev-ingest-token
FEED_STALE_SECONDS=60

# DEV FALLBACK ONLY: replay the recorded feed (UI shows "REPLAY"). Leave false for real use.
REPLAY_FEED=false
REPLAY_SPEED=1.0

# Road geometry service (the one god's-eye-view uses)
OSRM_URL=https://router.project-osrm.org
